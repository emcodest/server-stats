# Copy to .env and adjust for the box this runs on, or export these
# directly (systemd EnvironmentFile=, docker --env-file, etc). All three
# are optional — sane defaults are used for anything left unset.

# Interface to monitor. Leave unset to auto-detect: the default-route
# interface is used first (the one actually carrying internet traffic),
# falling back to the first non-virtual interface in /sys/class/net if
# that fails. Only set this if auto-detect picks the wrong NIC.
# NETWORK_IF=eth0

# Fallback port speed in Gbps, used only when the NIC doesn't report its
# own negotiated link speed (/sys/class/net/<iface>/speed) — common on
# virtualized/cloud NICs. Default: 1.0
# PORT_SPEED_GBPS=1.0

# Refresh interval in seconds. Default: 2
# INTERVAL_SECONDS=2

# Set both of these to also publish each snapshot to Redis for the Vapp
# admin dashboard, on top of the terminal dashboard. Leave unset to keep
# this running as a pure terminal tool, exactly as before.
# SERVER_ID=lk1
# REDIS_ADDR=10.0.0.5:6379
# REDIS_PASSWORD=
